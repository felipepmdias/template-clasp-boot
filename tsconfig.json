{
  "compilerOptions": {
    "noResolve": false,
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "preserveConstEnums": true,
    "module": "None",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/bootgs",
      "./src/libs/types",
      "./node_modules"
    ],
    "types": [
      "google-apps-script",
      "luxon",
      "bootgs"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}